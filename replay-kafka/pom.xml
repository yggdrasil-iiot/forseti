<?xml version="1.0" encoding="UTF-8"?>
<!-- The Kafka side of the engine-neutral replay harness of step 6 (plan D1): stores, topic settings, batch and barrier writing, the
     recording-to-broker offset mapping, completion reading, journal dumping, collectors and process supervision, behind the
     transport-free interfaces of cli's yggdrasil.forseti.cli.replay. It may carry exactly kafka-clients 4.2.2 and no engine
     (scripts/check-dependency-closure.sh); it depends on cli and cli never on it, so the core gate stays Kafka-free. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>yggdrasil.forseti</groupId><artifactId>forseti-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>forseti-replay-kafka</artifactId>
  <properties>
    <kafka.version>4.2.2</kafka.version>
  </properties>
  <dependencies>
    <dependency><groupId>yggdrasil.forseti</groupId><artifactId>forseti-cli</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId><version>${kafka.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId></dependency>
  </dependencies>
</project>
