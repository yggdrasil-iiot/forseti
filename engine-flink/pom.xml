<?xml version="1.0" encoding="UTF-8"?>
<!-- The Flink engine of step 6 (plan D1): the stage-1 and stage-2 jobs over forseti-core, on Flink 2.2.1 with the Kafka connector
     5.0.0-2.2. This is the only module that may carry Flink (scripts/check-dependency-closure.sh). kafka-clients is declared at 4.2.2,
     the client line of the whole repository, so it wins by nearest-wins over the connector's own 4.2.0. The tests under
     yggdrasil.forseti.engine.flink.spike confirm the engine assumptions of spec line 762 on the pinned versions
     (docs/ENGINE-ASSUMPTIONS.md) and stay as regression tests. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>yggdrasil.forseti</groupId><artifactId>forseti-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>forseti-engine-flink</artifactId>
  <properties>
    <flink.version>2.2.1</flink.version>
    <flink-connector-kafka.version>5.0.0-2.2</flink-connector-kafka.version>
    <kafka.version>4.2.2</kafka.version>
  </properties>
  <dependencies>
    <dependency><groupId>yggdrasil.forseti</groupId><artifactId>forseti-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-streaming-java</artifactId><version>${flink.version}</version></dependency>
    <dependency><groupId>org.apache.flink</groupId><artifactId>flink-connector-kafka</artifactId><version>${flink-connector-kafka.version}</version></dependency>
    <dependency><groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId><version>${kafka.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId></dependency>
  </dependencies>
</project>
