<?xml version="1.0" encoding="UTF-8"?>
<!-- The live-loop shells of step 5 (plan D1): topic admin, producers, the scenario driver and the Kafka reader around the Kafka-free
     live logic in cli. loop depends on cli and cli never on loop, so the transport clients stay off the classpath of the core gate
     (scripts/check-dependency-closure.sh). It may carry exactly kafka-clients 4.2.2 and the Eclipse Milo 1.1.8 client (plan D2).
     The tests use the MockProducer that kafka-clients ships; kafka-clients 4.2.2 publishes no test jar, so topic admin is tested
     behind its own port. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>yggdrasil.forseti</groupId><artifactId>forseti-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>forseti-loop</artifactId>
  <properties>
    <kafka.version>4.2.2</kafka.version>
    <milo.version>1.1.8</milo.version>
  </properties>
  <dependencies>
    <dependency><groupId>yggdrasil.forseti</groupId><artifactId>forseti-cli</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId><version>${kafka.version}</version></dependency>
    <dependency><groupId>org.eclipse.milo</groupId><artifactId>milo-sdk-client</artifactId><version>${milo.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId></dependency>
  </dependencies>
</project>
