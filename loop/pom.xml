<?xml version="1.0" encoding="UTF-8"?>
<!-- The live-loop shells of step 5 (plan D1): topic admin, producers, the scenario driver and the Kafka reader around the Kafka-free
     live logic in cli. loop depends on cli and cli never on loop, so the transport clients stay off the classpath of the core gate
     (scripts/check-dependency-closure.sh). It may carry exactly kafka-clients 4.2.2 and the Eclipse Milo 1.1.8 client (plan D2).
     The tests use the MockProducer that kafka-clients ships; kafka-clients 4.2.2 publishes no test jar, so topic admin is tested
     behind its own port. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>yggdrasil.forseti</groupId><artifactId>forseti-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>forseti-loop</artifactId>
  <properties>
    <kafka.version>4.2.2</kafka.version>
    <milo.version>1.1.8</milo.version>
  </properties>
  <dependencies>
    <dependency><groupId>yggdrasil.forseti</groupId><artifactId>forseti-cli</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId><version>${kafka.version}</version></dependency>
    <dependency><groupId>org.eclipse.milo</groupId><artifactId>milo-sdk-client</artifactId><version>${milo.version}</version></dependency>
    <!-- Milo 1.1.8 calls the SLF4J 2 API (Logger.atLevel); without this kafka-clients' slf4j-api 1.7.36 wins by nearest-wins and a
         Milo thread dies with NoSuchMethodError in the runnable jar. 2.0.20 is Milo's own line. -->
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.20</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId></dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- The runnable jar of the full-loop runner (scripts/run-full-loop-gate.sh): target/forseti-loop.jar. Signature files of signed
           dependencies are dropped (a merged jar cannot keep them) and service files are merged. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
        <executions><execution>
          <phase>package</phase><goals><goal>shade</goal></goals>
          <configuration>
            <finalName>forseti-loop</finalName>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <transformers>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>yggdrasil.forseti.loop.LoopMain</mainClass></transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
            </transformers>
            <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude></excludes></filter></filters>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
